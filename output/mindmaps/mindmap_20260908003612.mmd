mindmap
  root(("Multiple Linear Regression — I"))
  n1["3.1 Method of Least Squares"]
    n2["Term life insurance demand"]
      n3["Response: LNFACE"]
      n4["Predictors: EDUCATION, NUMHH, LNINCOME"]
      n5["275 households purchasing term life insurance"]
    n6["Multivariate data summaries"]
      n7["Summary statistics and logarithmic transforms"]
      n8["Scatterplot matrices summarize variable pairs"]
      n9["Correlations measure linear relationships only"]
    n10["Regression plane"]
      n11["\—y=b_0+b_1x_1+\cdots+b_kx_k\—"]
      n12["Plane lies in \—k+1\— dimensions"]
      n13["Usually cannot pass through all \—n\— observations"]
    n14["Least squares criterion"]
      n15["\—SS=\sum_—i=1—^—n——y_i-—b_0+\cdots+b_kx_—ik———^2\—"]
      n16["Minimizes squared deviations from fitted values"]
      n17["\—\widehat y=b_0+b_1x_1+\cdots+b_kx_k\—"]
    n18["Matrix notation and solution"]
      n19["\—\mathbf y\— is an \—n\times1\— response vector"]
      n20["\—\mathbf X\— is an \—n\times—k+1—\— explanatory matrix"]
      n21["Normal equations: \—\mathbf X'\mathbf X\mathbf b=\mathbf X'\mathbf y\—"]
      n22["\—\mathbf b=—\mathbf X'\mathbf X—^—-1—\mathbf X'\mathbf y\— when invertible"]
  n23["3.2 Linear Regression Model and Properties of Estimators"]
    n24["Regression function"]
      n25["\—\mathrm Ey=\beta_0x_0+\beta_1x_1+\cdots+\beta_kx_k\—"]
      n26["\—x_0=1\— gives the intercept"]
      n27["\—\beta_j\— is the expected change per unit \—x_j\—, holding others fixed"]
    n28["Coefficient interpretation"]
      n29["Positive NUMHH coefficient implies greater expected insurance demand"]
      n30["Log response changes can be interpreted as approximate percentage changes"]
      n31["Log-log coefficient is an elasticity"]
    n32["Model assumptions"]
      n33["F1: \—\mathrm Ey_i=\beta_0+\beta_1x_—i1—+\cdots+\beta_kx_—ik—\—"]
      n34["F2: explanatory variables are nonstochastic"]
      n35["F3–F4: constant variance \—\sigma^2\— and independent responses"]
      n36["F5: responses are normally distributed"]
    n37["Estimator properties"]
      n38["Property 1: \—\mathbf b\— is unbiased for \—\boldsymbol\beta\—"]
      n39["Property 2: \—\operatorname—Var—\mathbf b=\sigma^2—\mathbf X'\mathbf X—^—-1—\—"]
      n40["Property 3: \—\mathbf b\— is normally distributed under F1–F5"]
      n41["Gauss-Markov: least squares is minimum variance among linear unbiased estimators"]
  n42["3.3 Estimation and Goodness of Fit"]
    n43["Residual standard deviation"]
      n44["Residual: \—e_i=y_i-\widehat y_i\—"]
      n45["\—s^2=\frac—1——n-—k+1——\sum_—i=1—^—n——y_i-\widehat y_i—^2\—"]
      n46["\—s=\sqrt—s^2—\— is the residual standard deviation"]
      n47["Error degrees of freedom: \—n-—k+1—\—"]
    n48["Variability decomposition"]
      n49["Total SS = Error SS + Regression SS"]
      n50["Total variation is divided into unexplained and explained variation"]
      n51["Cross-product terms sum to zero"]
    n52["Coefficient of determination"]
      n53["\—R^2=\frac—\text—Regression SS———\text—Total SS——\—"]
      n54["\—R^2\— is the proportion of variability explained"]
      n55["\—R^2=—r—y,\widehat y——^2\—"]
      n56["\—R\— is the multiple correlation coefficient"]
    n57["ANOVA and adjusted fit"]
      n58["Regression degrees of freedom: \—k\—"]
      n59["Error mean square: \—MSE=s^2\—"]
      n60["\—R_a^2=1-\frac—s^2——s_y^2—\—"]
      n61["Adding a variable never decreases unadjusted \—R^2\—"]
    n62["Term life ANOVA example"]
      n63["Regression SS 328.47; Error SS 630.43; Total SS 958.90"]
      n64["\—R^2=34.3\%\—"]
      n65["\—s=1.525\— and \—R_a^2=33.6\%\—"]
  n66["3.4 Statistical Inference for a Single Coefficient"]
    n67["3.4.1 The \—t\—-test"]
      n68["Test \—H_0:\beta_j=0\— against \—H_a:\beta_j\ne0\—"]
      n69["\—se—b_j—=s\sqrt—\text—diagonal element of ——\mathbf X'\mathbf X—^—-1——\—"]
      n70["\—t—b_j—=b_j/se—b_j—\—"]
      n71["Degrees of freedom: \—n-—k+1—\—"]
      n72["Rule of thumb: \—|t|>2\— indicates an important variable"]
    n73["Alternative tests and \—p\—-values"]
      n74["Tests may use \—H_0:\beta_j=d\—"]
      n75["Alternatives may be one-sided or two-sided"]
      n76["\—p\—-values describe strength of evidence against the null"]
    n77["3.4.2 Confidence intervals"]
      n78["\—b_j\pm t_—n-—k+1—,1-\alpha/2—se—b_j—\—"]
      n79["A hypothesized value outside the interval is rejected by the two-sided test"]
    n80["3.4.3 Added variable plots"]
      n81["Regress response on all variables except \—x_j\— to obtain \—e_1\—"]
      n82["Regress \—x_j\— on the other variables to obtain \—e_2\—"]
      n83["Plot \—e_1\— versus \—e_2\—"]
      n84["Shows the relationship after controlling for other explanatory variables"]
    n85["Refrigerator price example"]
      n86["PRICE modeled by ECOST, RSIZE, FSIZE, SHELVES, FEATURES"]
      n87["Model fit: \—s=60.65\—, \—R^2=83.8\%\—"]
      n88["ECOST has a negative regression coefficient despite positive pairwise correlation"]
      n89["FSIZE can explain the positive PRICE–ECOST association"]
    n90["3.4.4 Partial correlation"]
      n91["Correlation between added-variable residuals \—e_1\— and \—e_2\—"]
      n92["Measures association of \—y\— and \—x_j\— controlling for other predictors"]
      n93["\—r=\frac—t—b_j———\sqrt—t—b_j—^2+n-—k+1———\—"]
      n94["Large \—t\—-ratios correspond to large partial correlations"]
  n95["3.5 Some Special Explanatory Variables"]
    n96["3.5.1 Binary variables"]
      n97["Categorical variables identify distinct groups"]
      n98["Binary variables are indicator or dummy variables"]
      n99["SINGLE equals 1 for single respondents and 0 otherwise"]
      n100["Binary coefficient compares the alternative level with the base level"]
      n101["Letter plots display a categorized third variable"]
    n102["3.5.2 Transforming explanatory variables"]
      n103["Regression is linear in parameters, not necessarily in explanatory variables"]
      n104["Polynomial regression uses \—x,x^2,\ldots,x^p\—"]
      n105["Log transforms can represent gently sloping curves"]
      n106["Continuous variables can be categorized with binary transforms"]
    n107["3.5.3 Interaction terms"]
      n108["Create \—x_3=x_1\times x_2\—"]
      n109["\—\frac—\partial \mathrm Ey——\partial x_1—=\beta_1+\beta_3x_2\—"]
      n110["Marginal effect of one variable depends on another variable"]
      n111["A linear combination such as \—x_1+x_2\— cannot be separately estimated"]
    n112["Curvilinear and piecewise models"]
      n113["Second-order models include squared and cross-product terms"]
      n114["Piecewise linear regression uses binary variables at kinks"]
      n115["Charitable-contribution example has a kink at \$97,500"]
      n116["Stock commission example has a discontinuity at 100 shares"]
    n117["Insurance company expense application"]
      n118["Segal models expenses using outputs, input prices, squares, and branch interactions"]
      n119["Branch indicator \—D\— changes output effects"]
      n120["Logarithmic coefficients are interpreted as elasticities"]
  n121["3.6 Further Reading, References, and 3.7 Exercises"]
    n122["Further reading"]
      n123["Goldberger 1991 provides proofs of Chapter 3 results"]
      n124["Bates and Watts 1988 discusses nonlinear regression"]
      n125["Chapter 4 extends categorical variables and joint inference"]
