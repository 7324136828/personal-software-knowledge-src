            {
              "name": "Apply modified logarithm transform \\(\\ln(1+x)\\)",
              "children": []
            },
            {
              "name": "Compare reduced, quadratic, and GROUP interaction models",
              "children": []
            }
          ]
        },
        {
          "name": "Exercise 3.6 National Life Expectancies",
          "children": [
            {
              "name": "Model LIFEEXP using FERTILITY, PUBLICEDUCATION, and \\(\\ln\\)HEALTH",
              "children": []
            },
            {
              "name": "Test the PUBLICEDUCATION coefficient",
              "children": []
            },
            {
              "name": "Interpret the added-variable plot controlling for FERTILITY and \\(\\ln\\)HEALTH",
              "children": []
            }
          ]
        }
      ]
    }
  ]
}
