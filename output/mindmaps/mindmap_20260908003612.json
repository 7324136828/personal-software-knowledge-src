              "children": []
            },
            {
              "name": "3.2 uses \\((\\mathbf X'\\mathbf X)^{-1}\\) for errors, covariance, correlation, and variance",
              "children": []
            },
            {
              "name": "3.3 fits a two-predictor model to a small fictitious dataset",
              "children": []
            }
          ]
        },
        {
          "name": "Exercise 3.4 Wisconsin Lottery",
          "children": [
            {
              "name": "Analyze SALES with eight economic and demographic variables",
              "children": []
            },
            {
              "name": "Compare full and parsimonious regression models",
              "children": []
            },
            {
              "name": "Use partial correlation and added-variable plots for MEDSCHYR",
              "children": []
            }
          ]
        },
        {
          "name": "Exercise 3.5 Insurance Company Expenses",
          "children": [
