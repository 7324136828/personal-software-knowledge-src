# ==============================================================================
# Skill-Driven Content Generator - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual API keys.
# DO NOT commit .env with real credentials into git.
# ==============================================================================

# OpenAI API Key & Model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic / Claude API Key & Model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenRouter API Key & Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=

# Local Ollama Configuration (No API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=600

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
