{
  "name": "chunked_with_overlap",
  "connector": "ollama",
  "model": "llama3.2:3b",
  "source_file": "input/Chapter 005. Variable Selection.txt",
  "action": "create_qandas",
  "strategy": "chunked",
  "chunking": {"strategy": "semantic", "target_tokens": 1500, "overlap_tokens": 200},
  "generation": {"max_output_tokens": 2048, "temperature": 0.0, "retries": 2, "passes": 2},
  "aggregation": {"strategy": "deterministic", "group_size": 4},
  "checkpoint": true, "keep_raw": true, "validate": true,
  "validation_criteria": {"min_coverage": 0.90, "require_schema_valid": true, "max_truncated_outputs": 0, "max_duplicate_ratio": 0.08}
}
