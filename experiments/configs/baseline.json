{
  "name": "baseline",
  "connector": "ollama",
  "model": "llama3.2:3b",
  "source_file": "input/Chapter 005. Variable Selection.txt",
  "action": "create_qandas",
  "strategy": "baseline",
  "chunking": {"strategy": "semantic", "target_tokens": 2400, "overlap_tokens": 0},
  "generation": {"max_output_tokens": 2048, "temperature": 0.0, "retries": 0, "passes": 1},
  "aggregation": {"strategy": "deterministic", "group_size": 4},
  "checkpoint": true,
  "keep_raw": true,
  "validate": true,
  "validation_criteria": {"require_schema_valid": true, "max_truncated_outputs": 0}
}
