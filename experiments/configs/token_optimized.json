{
  "name": "token_optimized",
  "connector": "ollama",
  "model": "llama3.2:3b",
  "source_file": "input/Chapter 005. Variable Selection.txt",
  "action": "create_qandas",
  "strategy": "extraction_then_generation",
  "chunking": {"strategy": "semantic", "target_tokens": 900, "overlap_tokens": 80},
  "generation": {"max_output_tokens": 1536, "temperature": 0.0, "retries": 3, "passes": 2},
  "aggregation": {"strategy": "hierarchical", "group_size": 3},
  "checkpoint": true, "keep_raw": true, "validate": true,
  "profile_overrides": {"context_window": 8192, "recommended_chunk_tokens": 900, "reserved_output_tokens": 1536},
  "validation_criteria": {"min_coverage": 0.90, "require_schema_valid": true, "max_truncated_outputs": 0}
}
